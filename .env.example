# ==============================================================================
# MLF Backend - Environment Variables for Local Testing
# ==============================================================================
# Copy this file to .env before starting the server:
#   cp .env.example .env
# ==============================================================================

# Application Environment (DEVELOPMENT | PRODUCTION | TEST)
NODE_ENV=DEVELOPMENT

# Server Port
PORT=3500

# Directory path for Winston logs
LOG_DIR=logs

# MongoDB Connection URI
# Local MongoDB instance: mongodb://localhost:27017/mlf (or mongodb://127.0.0.1:27017/mlf)
# Cloud / MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/mlf
MONGO_URI=mongodb://localhost:27017/mlf

# MongoDB Database Name
MONGO_DB_NAME=mlf

# Secret key used for signing & verifying Admin session JWT tokens
JWT_SECRET=mlf-secret-token-key-2026
